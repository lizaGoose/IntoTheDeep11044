<?xml version="1.0"?> 
 <robot name="robot"> 
     <link name="base_link"/>
     <link name="slider">
         <visual>
             <origin xyz="0 0 0" rpy="0 0 0"/>
         </visual>
     </link>
     
     <joint name="slide" type="prismatic">
         <parent link="base_link"/>
         <child link="slider"/>
         <origin rpy="0 0 0" xyz="0 0 0"/> 
         <axis xyz="0 1 0"/>
         <limit lower="0" upper="20"/>
     </joint>
     
     <link name="axis"> 
         <visual> 
             <geometry> 
                 <cylinder radius="2.43" length="3"/> 
             </geometry> 
             <origin rpy="0 1.57 0" xyz="0 0 0"/> 
         </visual> 
     </link>
     
     
     <joint name="vertical_angle" type="revolute">
         <parent link="slider"/>
         <child link="axis"/>
         <origin xyz="0 0 0" rpy="0 0 0" />
         <axis xyz="1 0 0"/>
         <limit lower="-0.785" upper="0.785" />
     </joint>
     
     
     <link name="arm"> 
         <visual> 
             <geometry> 
                 <cylinder radius="1" length="12.745"/> 
             </geometry> 
             <origin rpy="1.57 1.57 0" xyz="0 6.3725 2.43"/> 
         </visual> 
     </link>
     
     <joint name="coplanar_angle" type="revolute">
         <parent link="axis"/>
         <child link="arm"/>
         <origin xyz="0 0 0" rpy="0 0 0" />
         <axis xyz="0 0 1"/>
         <limit lower="-3.14" upper="3.14" />
     </joint>
     
     <link name="claw">
        <visual>
            <geometry>
                <cylinder radius="1" length="4"/>
            </geometry>
            <origin xyz="0 0 -2" rpy="0 0 0"/>
        </visual>
     </link>
     
     <joint name="claw_rotation" type="revolute">
         <parent link="arm"/>
         <child link="claw"/>
         <origin xyz="0 12.745 2.43" rpy="0 0 0" />
         <axis xyz="1 0 0"/>
         <limit lower="0" upper="3.14" />
     </joint>
 </robot>